               <font><Font size="18.0" /></font>
            </Label>
            <Label fx:id="winLoseLabel" layoutX="35.0" layoutY="53.0" text="Won / Lost" textFill="#333333">
               <font><Font size="34.0" /></font>
            </Label>
         </children>
      </AnchorPane>
      <AnchorPane prefHeight="240.0" prefWidth="635.0">
