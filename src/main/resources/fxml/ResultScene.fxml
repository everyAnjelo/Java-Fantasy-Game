                  </Label>
               </children>
            </AnchorPane>
            <AnchorPane layoutX="35.0" layoutY="132.0" prefHeight="52.0" prefWidth="565.0" style="-fx-border-color: #bdbdbd; -fx-background-color: #f7f7f7;">
               <children>
                  <Label layoutX="17.0" layoutY="15.0" text="Number of Completed Expedition">
                     <font><Font size="16.0" /></font>
                  </Label>
                  <Label fx:id="completedExpeditionLabel" alignment="CENTER_RIGHT" layoutX="523.0" layoutY="12.0" prefHeight="28.0" prefWidth="15.0" text="0">
                     <font><Font size="20.0" /></font>
                  </Label>
               </children>
            </AnchorPane>
         </children>
      </AnchorPane>
      <AnchorPane prefHeight="105.0" prefWidth="635.0">
