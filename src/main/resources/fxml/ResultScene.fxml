            <Label layoutX="276.0" layoutY="11.0" text="Result">
               <font><Font size="32.0" /></font>
            </Label>
         </children>
      </AnchorPane>
      <Separator prefWidth="635.0" />
      <AnchorPane prefHeight="95.0" prefWidth="635.0">
