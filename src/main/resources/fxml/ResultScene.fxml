                  <Label layoutX="17.0" layoutY="15.0" text="Number of Expedition Chosen">
                     <font><Font size="16.0" /></font>
                  </Label>
                  <Label fx:id="chosenExpeditionLabel" alignment="CENTER_RIGHT" layoutX="523.0" layoutY="12.0" prefHeight="28.0" prefWidth="15.0" text="0">
