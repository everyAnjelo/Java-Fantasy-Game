            <Label layoutX="35.0" layoutY="22.0" text="Guild Name">
               <font><Font size="18.0" /></font>
            </Label>
            <Label fx:id="guildNameLabel" layoutX="35.0" layoutY="50.0" text="No guild name yet" textFill="#555555">
               <font><Font size="24.0" /></font>
            </Label>
         </children>
      </AnchorPane>
      <AnchorPane prefHeight="110.0" prefWidth="635.0">
         <children>
            <Separator prefWidth="635.0" />
