            <Separator prefWidth="635.0" />
            <Label layoutX="35.0" layoutY="22.0" text="Total Gold">
               <font><Font size="18.0" /></font>
            </Label>
            <Label fx:id="totalGoldLabel" layoutX="35.0" layoutY="49.0" text="0 Gold" textFill="#555555">
               <font><Font size="28.0" /></font>
            </Label>
         </children>
      </AnchorPane>
      <AnchorPane prefHeight="123.0" prefWidth="635.0">
         <children>
            <Separator prefWidth="635.0" />
            <Button fx:id="exitButton" layoutX="260.0" layoutY="32.0" mnemonicParsing="false" prefHeight="42.0" prefWidth="115.0" text="Exit">
               <font><Font size="16.0" /></font>
